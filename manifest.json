{
  "manifest_version": 3,
  "name": "hed",
  "version": "0.8.0",
  "description": "Highlighting (and Javascript-ed) Ed.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": { "default_icon": { "128": "media/hed.png" } },
  "icons": { "128": "media/hed.png" },
  "options_page": "src/options/options.html",
  "commands": {
    "toggle-palette": {
      "suggested_key": { "default": "Ctrl+H", "mac": "MacCtrl+H" },
      "description": "Open the highlight command palette"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/vendor/prism-core.min.js",
        "src/vendor/prism-c.min.js",
        "src/vendor/prism-cpp.min.js",
        "src/vendor/prism-python.min.js",
        "src/vendor/prism-javascript.min.js",
        "src/vendor/prism-typescript.min.js",
        "src/vendor/prism-bash.min.js",
        "src/vendor/prism-go.min.js",
        "src/vendor/prism-rust.min.js",
        "src/vendor/prism-java.min.js",
        "src/vendor/prism-json.min.js",
        "src/content/ed.js",
        "src/content/highlighter.js",
        "src/content/highlightPatterns.js",
        "src/content/noteKeyUtils.js",
        "src/content/help.js",
        "src/content/palette.js",
        "src/content/selector.js",
        "src/content/notes.js"
      ],
      "css": [
        "styles/palette.css",
        "styles/highlights.css",
        "styles/notes.css",
        "styles/prism-solarized.css",
        "fonts/monoid.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/palette.css",
        "styles/highlights.css",
        "styles/notes.css",
        "fonts/monoid.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
